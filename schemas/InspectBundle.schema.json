{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "frequency": {
          "default": "daily",
          "title": "Frequency",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/TransformSpec"
          },
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "DatasetManifest",
      "type": "object"
    },
    "ExploratoryStatus": {
      "description": "Status of one exploratory diagnostic (``sieve inspect``).\n\nDeliberately weaker vocabulary than :class:`Status` \u2014 inspect mode never\nclaims PASS/FAIL, and OBSERVED asserts only that the diagnostic was\ncomputed and rendered from adequate data, **not** that a stylized fact\n\"holds\". Reading the figure is the user's job; confirmatory decisions\nbelong to ``sieve test``.",
      "enum": [
        "OBSERVED",
        "INSUFFICIENT",
        "NOT_APPLICABLE",
        "NOT_TESTED",
        "ERROR"
      ],
      "title": "ExploratoryStatus",
      "type": "string"
    },
    "FigureResult": {
      "additionalProperties": false,
      "description": "Outcome of rendering one registered figure for one dataset.",
      "properties": {
        "artifact_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Path"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "figure_id": {
          "title": "Figure Id",
          "type": "string"
        },
        "n_obs_used": {
          "default": 0,
          "title": "N Obs Used",
          "type": "integer"
        },
        "n_runs_used": {
          "default": 0,
          "title": "N Runs Used",
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "reading_guide": {
          "default": "",
          "title": "Reading Guide",
          "type": "string"
        },
        "related_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Related Metrics",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExploratoryStatus"
        },
        "stylized_fact": {
          "title": "Stylized Fact",
          "type": "string"
        },
        "summary_values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Summary Values",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "figure_id",
        "version",
        "display_name",
        "stylized_fact",
        "status"
      ],
      "title": "FigureResult",
      "type": "object"
    },
    "GeometrySummary": {
      "additionalProperties": false,
      "description": "Sampling geometry of the input, and where the label came from.",
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "geometry": {
          "title": "Geometry",
          "type": "string"
        },
        "geometry_source": {
          "title": "Geometry Source",
          "type": "string"
        },
        "n_obs_total": {
          "title": "N Obs Total",
          "type": "integer"
        },
        "n_runs": {
          "title": "N Runs",
          "type": "integer"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunSummary"
          },
          "title": "Runs",
          "type": "array"
        },
        "time_basis": {
          "title": "Time Basis",
          "type": "string"
        }
      },
      "required": [
        "geometry",
        "geometry_source",
        "time_basis",
        "n_runs",
        "n_obs_total"
      ],
      "title": "GeometrySummary",
      "type": "object"
    },
    "JsonValue": {},
    "MetricObservation": {
      "additionalProperties": false,
      "description": "One metric evaluated on one run (exploratory, not a test).",
      "properties": {
        "metric_ref": {
          "title": "Metric Ref",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExploratoryStatus",
          "default": "OBSERVED"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "metric_ref",
        "run_id"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "ModelManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "code_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Uri"
        },
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "model_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Family"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_hash": {
          "default": "",
          "title": "Parameters Hash",
          "type": "string"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "display_name",
        "adapter_id"
      ],
      "title": "ModelManifest",
      "type": "object"
    },
    "RunManifest": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "input_path": {
          "title": "Input Path",
          "type": "string"
        },
        "master_seed": {
          "title": "Master Seed",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed_tree": {
          "items": {
            "$ref": "#/$defs/SeedNode"
          },
          "title": "Seed Tree",
          "type": "array"
        },
        "sieve_version": {
          "title": "Sieve Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "sieve_version",
        "command",
        "master_seed",
        "input_path",
        "input_hash"
      ],
      "title": "RunManifest",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "description": "Per-run accounting: what went in, what burn-in removed.",
      "properties": {
        "irregular_spacing": {
          "default": false,
          "title": "Irregular Spacing",
          "type": "boolean"
        },
        "n_burned": {
          "default": 0,
          "title": "N Burned",
          "type": "integer"
        },
        "n_obs": {
          "title": "N Obs",
          "type": "integer"
        },
        "n_obs_raw": {
          "title": "N Obs Raw",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "run_id",
        "n_obs_raw",
        "n_obs"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "SeedNode": {
      "additionalProperties": false,
      "properties": {
        "entropy": {
          "title": "Entropy",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "spawn_key": {
          "items": {
            "type": "integer"
          },
          "title": "Spawn Key",
          "type": "array"
        }
      },
      "required": [
        "name",
        "entropy"
      ],
      "title": "SeedNode",
      "type": "object"
    },
    "TransformSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "TransformSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable artifact of ``sieve inspect``: exploratory evidence only.\n\nContains no PASS/FAIL, no p-values and no reference comparison \u2014 those\nbelong to ``sieve test``. Sealed with the same two-layer scheme as\n:class:`EvidenceBundle` (deterministic ``bundle_hash`` + file sidecar).",
  "properties": {
    "artifact_index": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Index",
      "type": "array"
    },
    "bundle_hash": {
      "default": "",
      "title": "Bundle Hash",
      "type": "string"
    },
    "bundle_id": {
      "format": "uuid",
      "title": "Bundle Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetManifest"
    },
    "figures": {
      "items": {
        "$ref": "#/$defs/FigureResult"
      },
      "title": "Figures",
      "type": "array"
    },
    "geometry": {
      "$ref": "#/$defs/GeometrySummary"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric_observations": {
      "items": {
        "$ref": "#/$defs/MetricObservation"
      },
      "title": "Metric Observations",
      "type": "array"
    },
    "mode": {
      "const": "exploratory",
      "default": "exploratory",
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelManifest"
    },
    "run_manifest": {
      "$ref": "#/$defs/RunManifest"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_hash": {
      "title": "Suite Hash",
      "type": "string"
    },
    "suite_ref": {
      "title": "Suite Ref",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "created_at",
    "run_manifest",
    "model",
    "dataset",
    "suite_ref",
    "suite_hash",
    "geometry"
  ],
  "title": "InspectBundle",
  "type": "object"
}
