<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ product }} model-update comparison — {{ c.side_a.display_name }} → {{ c.side_b.display_name }}</title>
<style>
  :root { --ink:#14181f; --muted:#5a6577; --rule:#d5dce4; --panel:#f5f7fa;
          --same:#1b7a44; --chg:#b8471f; --warn:#a06a00; --na:#5a6577; }
  * { box-sizing: border-box; }
  body { margin:0; font: 15px/1.7 system-ui, sans-serif; color:var(--ink); }
  .wrap { max-width: 66rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  h1 { font-size: 1.4rem; margin: 0 0 .25rem; }
  h2 { font-size: 1.1rem; border-bottom: 2px solid var(--ink);
       padding-bottom:.3rem; margin: 2.2rem 0 .8rem; }
  .muted { color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: .9em; }
  th, td { text-align: left; padding: .45rem .55rem;
           border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  .num { font-variant-numeric: tabular-nums; text-align: right; }
  .v { font-weight: 700; font-size: .85em; letter-spacing: .03em; }
  .v.CHANGED, .v.REGRESSION, .v.REVIEW_REQUIRED { color: var(--chg); }
  .v.NOT_SEPARATED, .v.STABLE, .v.IMPROVEMENT, .v.NO_CHANGE_DETECTED { color: var(--same); }
  .v.CHANGED_WITHIN_GATE { color: var(--warn); }
  .v.INSUFFICIENT, .v.INDETERMINATE { color: var(--na); }
  .st { font-size:.8em; font-weight:600; }
  .st.PASS { color: var(--same); } .st.FAIL { color: var(--chg); }
  .st.WARN { color: var(--warn); }
  .st.INSUFFICIENT, .st.NOT_TESTED { color: var(--na); }
  .box { background: var(--panel); border-left: 4px solid var(--ink);
         padding: .8rem 1rem; margin: 1rem 0; }
  .decision { border-left-color: var(--chg); }
  .decision.ok { border-left-color: var(--same); }
  ul { margin:.3rem 0 .6rem 1.2rem; padding:0; }
  footer { margin-top:3rem; border-top:1px solid var(--rule);
           padding-top:1rem; font-size:.85em; color:var(--muted); }
  code { background: var(--panel); padding:0 .3em; border-radius:3px;
         font-size:.9em; }
</style>
</head>
<body><div class="wrap">

<h1>Model-update comparison</h1>
<div class="muted">{{ product }} · suite {{ c.suite_id }}@{{ c.suite_version }}
· claim {{ c.claim_id }} · compare <code>{{ c.compare_hash[:16] }}…</code></div>

<div class="box">
  <b>A (baseline):</b> {{ c.side_a.display_name }}
  <span class="muted">v{{ c.side_a.model_version }} ·
  {{ c.side_a.n_windows }} windows · bundle
  <code>{{ c.side_a.bundle_hash[:12] }}…</code></span>
  {% if link_a %}· <a href="{{ link_a }}">full report &amp; findings</a>{% endif %}<br>
  <b>B (candidate):</b> {{ c.side_b.display_name }}
  <span class="muted">v{{ c.side_b.model_version }} ·
  {{ c.side_b.n_windows }} windows · bundle
  <code>{{ c.side_b.bundle_hash[:12] }}…</code></span>
  {% if link_b %}· <a href="{{ link_b }}">full report &amp; findings</a>{% endif %}
</div>

{% if c.approval %}
<div class="box decision {{ 'ok' if c.approval.outcome == 'NO_CHANGE_DETECTED' else '' }}">
  <span class="v {{ c.approval.outcome }}">{{ c.approval.outcome }}</span>
  <span class="muted">— policy {{ c.approval.policy_id }}@{{ c.approval.policy_version }}
  over required dimensions: {{ c.approval.required_dimensions|join(", ") }}</span>
  {% if c.approval.triggered_by %}
  <ul>{% for t in c.approval.triggered_by %}<li>{{ t }}</li>{% endfor %}</ul>
  {% endif %}
  <div class="muted" style="font-size:.85em">{{ c.approval.policy_text }}</div>
</div>
{% endif %}

<h2>1 · What was declared to change</h2>
{% if c.parameter_changes %}
<table>
  <tr><th>Manifest parameter</th><th class="num">A</th><th class="num">B</th></tr>
  {% for pc in c.parameter_changes %}
  <tr><td><code>{{ pc.name }}</code></td>
      <td class="num">{{ pc.value_a }}</td>
      <td class="num">{{ pc.value_b }}</td></tr>
  {% endfor %}
</table>
<p class="muted">As declared in the two model manifests — what the authors
say changed. The rows below measure what actually changed.</p>
{% else %}
<p>The two manifests declare identical parameters. Any measured change below
is therefore undeclared — treat it as a provenance question, not only a
statistical one.</p>
{% endif %}

<h2>2 · What measurably changed</h2>
<table>
  <tr><th>Metric</th><th>Verdict</th><th>Transition</th>
      <th class="num">KS(A,B)</th><th class="num">p (adj)</th>
      <th class="num">median A → B</th><th class="num">Δ%</th>
      <th>A vs ref</th><th>B vs ref</th></tr>
  {% for r in c.results %}
  {% set mid = r.metric_ref.split("@")[0] %}
  <tr>
    <td><code>{{ mid }}</code><br><span class="muted" style="font-size:.8em">{{ r.dimension.replace("_"," ") }}</span></td>
    <td><span class="v {{ r.verdict }}">{{ r.verdict }}</span></td>
    <td><span class="v {{ r.transition }}">{{ r.transition }}</span></td>
    <td class="num">{{ "%.3f"|format(r.ks_ab) if r.ks_ab is not none else "—" }}</td>
    <td class="num">{{ "%.4f"|format(r.adjusted_p_value) if r.adjusted_p_value is not none else "—" }}</td>
    <td class="num">{{ "%.3g"|format(r.median_a) if r.median_a is not none else "—" }} →
                    {{ "%.3g"|format(r.median_b) if r.median_b is not none else "—" }}</td>
    <td class="num">{{ "%+.0f%%"|format(r.median_change_pct) if r.median_change_pct is not none else "—" }}</td>
    <td><span class="st {{ r.status_a_vs_reference.value }}">{{ r.status_a_vs_reference.value }}</span></td>
    <td><span class="st {{ r.status_b_vs_reference.value }}">{{ r.status_b_vs_reference.value }}</span></td>
  </tr>
  {% endfor %}
</table>

<h2>3 · How to read this</h2>
<ul>
  <li><b>REGRESSION</b> — A passed the reference gate, B fails it.</li>
  <li><b>IMPROVEMENT</b> — A failed, B passes. Never blocks approval.</li>
  <li><b>CHANGED_WITHIN_GATE</b> — the distribution moved but both versions
      sit on the same side of the reference gate; the reference test alone
      would not have noticed. Needs a human judgment: intended or not?</li>
  <li><b>STABLE</b> — no detected move, gate statuses unchanged.</li>
  <li><b>NOT_SEPARATED</b> — no detectable difference at this line with
      this many windows. Not a claim of equality.</li>
</ul>

<h2>4 · Caveats</h2>
<ul>{% for cv in c.caveats %}<li>{{ cv }}</li>{% endfor %}</ul>

<h2>5 · Provenance</h2>
<table>
  <tr><th>Compare</th><td><code>{{ c.compare_id }}</code> ·
      {{ product|lower }} {{ c.sieve_version }} · seed {{ c.master_seed }}</td></tr>
  <tr><th>Suite hash</th><td><code>{{ c.suite_hash[:16] }}…</code></td></tr>
  <tr><th>Inputs</th><td>A input sha256 <code>{{ c.side_a.input_hash[:12] }}…</code>
      · B input sha256 <code>{{ c.side_b.input_hash[:12] }}…</code>
      (both runs verified before comparison)</td></tr>
</table>

<footer>{{ footer }}<br>
Verify: <code>sha256sum -c compare.sha256</code> · both source runs:
<code>sieve verify &lt;run-dir&gt;</code></footer>
</div></body>
</html>
